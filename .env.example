# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋하지 않는다.
#
#   cp .env.example .env
#
# 모든 설정은 DII_ 접두사를 붙인다.

# 실행 환경: local | prod
DII_APP_ENV=local

# 로그 레벨: DEBUG | INFO | WARNING | ERROR | CRITICAL
DII_LOG_LEVEL=INFO

# 수집 데이터와 로컬 DB 가 놓일 디렉토리 (기본값: 프로젝트 루트의 data/)
# DII_DATA_DIR=

# SEC EDGAR 신원 표기. 연락 가능한 이메일이 반드시 들어가야 한다.
# SEC 의 요구사항이며, 없으면 차단된다. `dii collect-docs` 에 필수.
DII_SEC_USER_AGENT="Your Name your@email.com"

# SEC 요청 사이 최소 간격(초). SEC 제한은 초당 10회이므로 0.1 이 하한이다.
# DII_SEC_MIN_INTERVAL=0.15

# --- 아래는 해당 마일스톤에서 추가된다 ---
# M4: LLM API 키
# DII_LLM_API_KEY=
