# 이 파일을 .env 로 복사해서 값을 채운다. .env 는 커밋하지 않는다.
#
#   cp .env.example .env
#
# 모든 설정은 DII_ 접두사를 붙인다.

# 실행 환경: local | prod
DII_APP_ENV=local

# 로그 레벨: DEBUG | INFO | WARNING | ERROR | CRITICAL
DII_LOG_LEVEL=INFO

# 수집 데이터와 로컬 DB 가 놓일 디렉토리 (기본값: 프로젝트 루트의 data/)
# DII_DATA_DIR=

# --- 아래는 해당 마일스톤에서 추가된다 ---
# M3: SEC EDGAR 는 요청 시 신원 표기를 요구한다 (이름과 이메일)
# DII_SEC_USER_AGENT="Your Name your@email.com"
# M4: LLM API 키
# DII_LLM_API_KEY=
