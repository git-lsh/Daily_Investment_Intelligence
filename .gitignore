# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/

# ---- 테스트 / 린트 캐시 ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- 환경변수 / 시크릿 ----
# API 키(증권 데이터, LLM, DART/SEC 등)는 절대 커밋하지 않는다.
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ---- 데이터 ----
# 원본/가공 데이터는 재수집 가능하므로 저장소에 넣지 않는다.
data/
*.db
*.sqlite
*.sqlite3
*.parquet
*.csv
!docs/**/*.csv

# ---- 로그 / 산출물 ----
logs/
*.log
reports/
outputs/

# ---- 노트북 ----
.ipynb_checkpoints/

# ---- 에디터 / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
